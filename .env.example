# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron (production) — rastgele güçlü bir string; Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Resend (e-posta) — placeholder ile sistem çalışır, e-posta atlanır
RESEND_API_KEY=placeholder

# Uygulama URL (e-posta linkleri; production: https://ops.tekodak.com.tr)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opsiyonel: test e-postası alıcısı (yalnızca development — GET /api/test-email?type=welcome)
TEST_EMAIL_TO=

# Opsiyonel: e-posta şablonlarında logo
EMAIL_LOGO_URL=https://tekodak.com.tr/logo.png

# Vercel otomatik sağlar (production); yerelde boş bırakılabilir
# VERCEL_URL=
